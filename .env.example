# Secure defaults. Production supports local accounts only and refuses disabled auth.
IPAPER_ENV=production
IPAPER_AUTH_MODE=local
IPAPER_COOKIE_SECURE=true

# Translation worker connection. The authentication token is a separate file,
# never an environment variable. Compose mounts it from deploy/ipaper-worker.token.
IPAPER_TRANSLATION_WORKER_URL=http://ipaper-translation-worker:7192
IPAPER_TRANSLATION_JOBS_ROOT=/work/jobs
IPAPER_WORKER_TOKEN_FILE=/run/secrets/ipaper_worker_token
IPAPER_SETTINGS_KEY_FILE=/run/secrets/ipaper_settings_key

# Isolated Document Worker. Its separate token is mounted from
# deploy/ipaper-document-worker.token and is never placed in this file.
IPAPER_DOCUMENT_WORKER_URL=http://ipaper-document-worker:7193
IPAPER_DOCUMENT_JOBS_ROOT=/work/document-jobs
IPAPER_DOCUMENT_WORKER_TOKEN_FILE=/run/secrets/ipaper_document_worker_token
IPAPER_MAX_PDF_BYTES=104857600
IPAPER_MAX_ARCHIVE_BYTES=209715200
IPAPER_MAX_ARCHIVE_EXPANDED_BYTES=2147483648
IPAPER_MAX_ARCHIVE_ENTRIES=2000
IPAPER_MAX_IMPORT_PAPERS=500

# Optional bootstrap origins. After v0.9.0 starts, administrators approve public
# HTTPS Providers in the web UI without changing this file or restarting.
IPAPER_AI_ALLOWED_ORIGINS=https://api.openai.com
# Private HTTP(S) targets must be individually approved; loopback and link-local
# addresses remain forbidden even when listed.
IPAPER_AI_PRIVATE_ALLOWED_ORIGINS=
# Optional RFC 2544 range used by transparent DNS fake-IP proxies. This only
# applies to administrator-approved public HTTPS hostnames; IP-literal and LAN
# destinations remain forbidden. Leave empty unless DNS returns 198.18.0.0/15.
IPAPER_AI_PROXY_FAKE_IP_RANGES=
# Exact public origins used by MinerU pre-signed upload/result URLs.
IPAPER_MINERU_TRANSFER_ALLOWED_ORIGINS=

# arXiv-only proxy. Leave empty to connect directly.
# Use ARXIV_PROXY for both HTTP and HTTPS arXiv URLs, or set scheme-specific
# values below. These variables are only applied to arxiv.org/export.arxiv.org.
ARXIV_PROXY=
ARXIV_API_PROXY=
ARXIV_HTTP_PROXY=
ARXIV_HTTPS_PROXY=

# Structured output quotas (1.2.0). Per immutable result / per account, in bytes.
IPAPER_STRUCTURE_RESULT_MAX_BYTES=1073741824
IPAPER_STRUCTURE_OWNER_MAX_BYTES=10737418240

# Optional proxy for fixed public bibliographic providers (metadata only).
# Empty means direct; arXiv may still use its existing dedicated proxy.
# Never place authentication tokens in a public environment example.
IPAPER_METADATA_PROXY=
